# Copy to ~/.config/admiralty/admiralty.env (mode 0600) and replace every path.
# Plain KEY=value lines only: systemd does not expand ~, %h or $VARS here.

# Owned release root (no group/other write) containing versions/ and current.
ADMIRALTY_ROOT=/home/OPERATOR/.local/share/admiralty
# Private 0700 state: native.sqlite and the 0600 dashboard-token.
# Create with: admiralty state init --dir /home/OPERATOR/.local/state/admiralty
ADMIRALTY_STATE=/home/OPERATOR/.local/state/admiralty
# Observer output_dir from the observer configuration (contains status.json).
ADMIRALTY_OBSERVE_DIR=/home/OPERATOR/.local/state/admiralty/observe
ADMIRALTY_OBSERVE_CONFIG=/home/OPERATOR/.config/admiralty/observe.json
# Original detailed HTML served at /legacy/ (dashboard/index.html from the reviewed source).
ADMIRALTY_LEGACY_INDEX=/home/OPERATOR/.local/share/admiralty/legacy/index.html
# Keep the listener on loopback; use an authenticated SSH tunnel for remote access.
ADMIRALTY_LISTEN=127.0.0.1:18890
# Optional extra admiraltyd flags, for example:
#   --redirect-listen 127.0.0.1:18891 --models-file /home/OPERATOR/.config/admiralty/models.json
ADMIRALTYD_EXTRA_ARGS=
# logfmt (compact, default) or json (NDJSON).
ADMIRALTY_LOG_FORMAT=logfmt
ADMIRALTY_LOG_ROLLUP_SECONDS=600
