# Admiralty coordinator and dashboard (read-only fleet console by default).
#
# Install: copy to /etc/systemd/system/, create the `admiralty` user, then
#   systemctl daemon-reload && systemctl enable --now admiraltyd
# Paths follow docs/operators/deployment-systemd.md. Add flags such as
# --legacy-status-file, --native-config or --operator-chat-config with a
# drop-in (`systemctl edit admiraltyd`) instead of editing this file.
#
# The dashboard is served from the active release bundle automatically
# (current/share/admiralty/dashboard); no --assets flag is needed.

[Unit]
Description=Admiralty coordinator and dashboard (admiraltyd)
Documentation=https://github.com/neverhuman/admiralty/blob/main/docs/operators/deployment-systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admiralty
Group=admiralty
UMask=0077
# Compact agent-ready logs (ALOG/1) to the journal; `json` for log shippers.
Environment=ADMIRALTY_LOG=info
Environment=ADMIRALTY_LOG_FORMAT=compact
ExecStart=/srv/admiralty/releases/current/bin/admiraltyd \
    --database /srv/admiralty/private/native.sqlite \
    --token-file /srv/admiralty/private/dashboard-token \
    --listen 127.0.0.1:18891
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=8192

# Least privilege: the service only needs its private state directory and
# read access to the release bundle and observer output.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/admiralty/private
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
