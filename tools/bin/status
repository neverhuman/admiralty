#!/usr/bin/env bash
# status — snap+classify all monitored sessions; concise multi-session report.
# Exit 0 unless screen binary missing (local tool failure).
set -uo pipefail

BASE="/home/ubuntu/xbabe2_kicker"
BIN="$BASE/bin"
SESSIONS=(grok_red jopedime_codex_cleanup jopeDime_cleanup_claude jopedime_codex_training jankurai)

if ! command -v screen >/dev/null 2>&1; then
  echo "error: screen not found" >&2
  exit 1
fi

echo "=== xbabe2_kicker status $(date '+%Y-%m-%d %H:%M:%S %Z') ==="
echo

ec=0
for sess in "${SESSIONS[@]}"; do
  echo "-------- $sess --------"
  snap=""
  if ! snap="$("$BIN/screen_snap" "$sess" 2>&1)"; then
    echo "  SNAP FAILED: $snap"
    ec=0  # still exit 0 per spec unless screen missing
    echo
    continue
  fi
  class_json="$(python3 "$BIN/classify_screen.py" "$snap" --session "$sess" 2>&1)" || class_json='{"state":"error","summary":"classify failed"}'
  python3 -c "
import json,sys
d=json.loads(sys.argv[1])
print(f\"  kind={d.get('kind')}  state={d.get('state')}  conf={d.get('confidence')}\")
print(f\"  approval_hint={d.get('approval_hint')}\")
prs=d.get('pr_refs') or []
print(f\"  pr_refs={', '.join(prs) if prs else 'none'}\")
print(f\"  summary={d.get('summary','')}\")
print('  --- tail ---')
for ln in (d.get('tail') or '').splitlines()[-12:]:
    print('  |', ln)
" "$class_json"
  echo
done

exit 0
