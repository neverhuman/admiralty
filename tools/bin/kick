#!/usr/bin/env bash
# kick — operator for xbabe2_kicker screen sessions
# Usage:
#   kick [--dry-run] [--session NAME] [--once] [--inject 'text']
#   kick --inject SESSION 'free text'
set -euo pipefail

BASE="/home/ubuntu/xbabe2_kicker"
BIN="$BASE/bin"
STATE_DIR="$BASE/state"
LOG="$BASE/logs/kick.log"
DEFAULT_SESSIONS=(grok_red jopedime_codex_cleanup jopeDime_cleanup_claude jopedime_codex_training jankurai)
PR_COOLDOWN_SEC=$((15 * 60))

PR_NUDGE='Continue. If anything is blocked on an open PR (CI, review, merge conflict), fix it and drive it to merge. Do not abandon, close, or reject the PR. Full permission — always approve. Keep going.'

CLAUDE_GRANT_NUDGE='Keep going. Ping Codex again for the CPU grant / ledger slot if there is still no reply. Do not wait idle — re-check AGENT_CHAT, re-arm watches, and proceed on any unblocked work. Full permission / bypass — always approve.'

DRY_RUN=0
ONCE=1  # default behavior is one pass over sessions
SESSION_FILTER=""
INJECT_TEXT=""
INJECT_ONLY=0
INJECT_SESSION=""

usage() {
  cat <<'U' >&2
usage: kick [--dry-run] [--session NAME] [--once] [--inject 'text']
       kick --inject SESSION 'free text'
U
  exit 2
}

# Parse args — support both styles
args=("$@")
i=0
while [[ $i -lt $# ]]; do
  a="${args[$i]}"
  case "$a" in
    --dry-run) DRY_RUN=1 ;;
    --once) ONCE=1 ;;
    --session)
      i=$((i + 1))
      SESSION_FILTER="${args[$i]:-}"
      [[ -z "$SESSION_FILTER" ]] && usage
      ;;
    --inject)
      # Could be: kick --inject 'text' (with --session) OR kick --inject SESSION 'text'
      i=$((i + 1))
      next="${args[$i]:-}"
      [[ -z "$next" ]] && usage
      # Peek: if another arg exists and current looks like a session name we know / no spaces
      peek="${args[$((i + 1))]:-}"
      if [[ -n "$peek" && "$next" != *" "* && "$next" != Continue* ]]; then
        # treat as SESSION 'text'
        INJECT_SESSION="$next"
        i=$((i + 1))
        INJECT_TEXT="${args[$i]:-}"
        INJECT_ONLY=1
      else
        INJECT_TEXT="$next"
      fi
      ;;
    -h|--help) usage ;;
    *)
      echo "unknown arg: $a" >&2
      usage
      ;;
  esac
  i=$((i + 1))
done

mkdir -p "$STATE_DIR" "$BASE/logs" "$STATE_DIR/snaps"

log_line() {
  local msg="$1"
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S %Z')"
  echo "[$ts] $msg" >> "$LOG"
}

# jope-disk-guard writes this while root free space is under 500 GiB.
# Dry runs still report. Live kicks and injects do not start new work.
HOLD="$STATE_DIR/DISK_HOLD"
if [[ -f "$HOLD" && "$DRY_RUN" -eq 0 ]]; then
  echo "DISK_HOLD is set ($HOLD). Refusing to kick or inject until root free space stays above 600 GiB and the guard removes this file." >&2
  sed -n '1,5p' "$HOLD" >&2 || true
  log_line "REFUSED disk hold"
  exit 75
fi

last_kick_epoch() {
  local sess="$1"
  local f="$STATE_DIR/${sess}.json"
  if [[ -f "$f" ]]; then
    python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(int(d.get('last_pr_nudge_epoch') or 0))" "$f" 2>/dev/null || echo 0
  else
    echo 0
  fi
}

send_approve() {
  local sess="$1" kind="$2" hint="${3:-}"
  local action_desc=""
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "  [dry-run] would approve kind=$kind hint=$hint"
    return 0
  fi
  case "$kind" in
    claude)
      # Prefer numbered always-allow (2), then shift-tab bypass, then y
      if [[ "$hint" == "2" || "$hint" == "always" ]]; then
        "$BIN/screen_send" "$sess" --keys 2 >/dev/null
        sleep 0.2
        "$BIN/screen_send" "$sess" --keys enter >/dev/null || true
        action_desc="claude_approve:2"
      elif [[ "$hint" == "bypass" ]]; then
        "$BIN/screen_send" "$sess" --keys shifttab >/dev/null
        action_desc="claude_approve:shifttab"
      else
        "$BIN/screen_send" "$sess" --keys 2 >/dev/null
        sleep 0.15
        "$BIN/screen_send" "$sess" --text 'always allow' >/dev/null || true
        action_desc="claude_approve:2+always"
      fi
      ;;
    grok)
      # Plan approval: 'a' = approve; also try always
      if [[ "$hint" == "a" ]]; then
        "$BIN/screen_send" "$sess" --keys a >/dev/null
        action_desc="grok_approve:a"
      else
        "$BIN/screen_send" "$sess" --keys a >/dev/null
        sleep 0.2
        "$BIN/screen_send" "$sess" --keys y >/dev/null
        action_desc="grok_approve:a+y"
      fi
      ;;
    codex)
      "$BIN/screen_send" "$sess" --keys y >/dev/null
      sleep 0.1
      "$BIN/screen_send" "$sess" --text 'always' >/dev/null || true
      action_desc="codex_approve:y+always"
      ;;
    *)
      "$BIN/screen_send" "$sess" --keys y >/dev/null
      action_desc="unknown_approve:y"
      ;;
  esac
  echo "  action: $action_desc"
  log_line "$sess ACTION $action_desc"
}

send_text() {
  local sess="$1" msg="$2" label="${3:-inject}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "  [dry-run] would inject ($label): ${msg:0:80}..."
    return 0
  fi
  "$BIN/screen_send" "$sess" --text "$msg" >/dev/null
  echo "  action: $label (${#msg} chars)"
  log_line "$sess ACTION $label"
}

write_state() {
  local sess="$1" class_json="$2" action="$3" pr_nudge_epoch="$4"
  python3 - "$STATE_DIR/${sess}.json" "$sess" "$class_json" "$action" "$pr_nudge_epoch" <<'PY'
import json, sys, time
path, sess, class_s, action, pr_ep = sys.argv[1:6]
try:
    cls = json.loads(class_s)
except Exception:
    cls = {"raw": class_s}
prev = {}
try:
    with open(path) as f:
        prev = json.load(f)
except Exception:
    pass
out = {
    "session": sess,
    "updated_epoch": int(time.time()),
    "updated_at": time.strftime("%Y-%m-%d %H:%M:%S %Z"),
    "last_action": action,
    "last_pr_nudge_epoch": int(pr_ep) if str(pr_ep).isdigit() else int(prev.get("last_pr_nudge_epoch") or 0),
    "classification": cls,
}
with open(path, "w") as f:
    json.dump(out, f, indent=2)
    f.write("\n")
PY
}

process_session() {
  local sess="$1"
  echo "======== $sess ========"
  local snap
  if ! snap="$("$BIN/screen_snap" "$sess" 2>&1)"; then
    echo "  ERROR: snap failed: $snap"
    log_line "$sess ERROR snap_failed: $snap"
    write_state "$sess" '{"state":"error","summary":"snap failed"}' "snap_failed" "$(last_kick_epoch "$sess")"
    return 0
  fi
  echo "  snap: $snap"

  local class_json
  if ! class_json="$(python3 "$BIN/classify_screen.py" "$snap" --session "$sess" 2>&1)"; then
    echo "  ERROR: classify failed: $class_json"
    log_line "$sess ERROR classify_failed"
    return 0
  fi

  # Extract fields
  local kind state hint summary confidence
  kind="$(printf '%s' "$class_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('kind',''))")"
  state="$(printf '%s' "$class_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('state',''))")"
  hint="$(printf '%s' "$class_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('approval_hint') or '')")"
  summary="$(printf '%s' "$class_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('summary',''))")"
  confidence="$(printf '%s' "$class_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('confidence',0))")"
  local pr_refs
  pr_refs="$(printf '%s' "$class_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(', '.join(d.get('pr_refs') or []))")"

  echo "  kind=$kind  state=$state  conf=$confidence  hint=${hint:-none}"
  echo "  pr_refs: ${pr_refs:-none}"
  echo "  summary: $summary"

  local action="none"
  local now pr_last
  now="$(date +%s)"
  pr_last="$(last_kick_epoch "$sess")"

  # Optional forced inject for this session (when --inject text with --session)
  if [[ -n "$INJECT_TEXT" && "$INJECT_ONLY" -eq 0 ]]; then
    send_text "$sess" "$INJECT_TEXT" "manual_inject"
    action="manual_inject"
    write_state "$sess" "$class_json" "$action" "$pr_last"
    log_line "$sess state=$state action=$action"
    echo
    return 0
  fi

  case "$state" in
    needs_approval)
      send_approve "$sess" "$kind" "$hint"
      action="approve:${hint:-auto}"
      ;;
    pr_blocked)
      if [[ $((now - pr_last)) -ge $PR_COOLDOWN_SEC ]]; then
        send_text "$sess" "$PR_NUDGE" "pr_nudge"
        action="pr_nudge"
        pr_last="$now"
      else
        local left=$((PR_COOLDOWN_SEC - (now - pr_last)))
        echo "  skip pr_nudge (cooldown ${left}s remaining)"
        action="pr_nudge_cooldown"
      fi
      ;;
    needs_input)
      # Answer clear yes/approve questions with full permission
      local tail_low
      tail_low="$(printf '%s' "$class_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print((d.get('tail') or '').lower())")"
      if echo "$tail_low" | grep -qE 'allow|approv|permission|yolo|proceed|continue|yes\b'; then
        if [[ "$kind" == "codex" ]]; then
          send_text "$sess" "Yes — full permission / YOLO. Always approve. Proceed and keep going; if a PR is blocked, fix and merge it — do not abandon." "input_yes"
        else
          send_approve "$sess" "$kind" "${hint:-y}"
        fi
        action="input_yes"
      else
        echo "  needs_input but no clear yes/approve cue — not auto-clicking"
        action="needs_input_ambiguous"
      fi
      ;;
    idle)
      # Claude waiting on Codex grant: nudge once per cooldown using pr_nudge epoch slot
      # (reuse last_pr_nudge_epoch as general nudge cooldown for grant waits)
      if [[ "$kind" == "claude" ]] && echo "$summary $class_json" | grep -qiE 'grant|ping codex|waiting on'; then
        if [[ $((now - pr_last)) -ge $PR_COOLDOWN_SEC ]]; then
          send_text "$sess" "$CLAUDE_GRANT_NUDGE" "claude_grant_nudge"
          action="claude_grant_nudge"
          pr_last="$now"
        else
          echo "  skip grant nudge (cooldown)"
          action="grant_nudge_cooldown"
        fi
      else
        echo "  idle — no action"
      fi
      ;;
    working|error|unknown)
      echo "  no auto-action for state=$state"
      ;;
  esac

  write_state "$sess" "$class_json" "$action" "$pr_last"
  log_line "$sess state=$state kind=$kind action=$action conf=$confidence"
  echo "  recorded action: $action"
  echo
}

# --inject SESSION 'text' fast path
if [[ "$INJECT_ONLY" -eq 1 ]]; then
  echo "======== inject → $INJECT_SESSION ========"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "  [dry-run] ${INJECT_TEXT:0:100}"
  else
    "$BIN/screen_send" "$INJECT_SESSION" --text "$INJECT_TEXT"
    log_line "$INJECT_SESSION ACTION manual_inject_cli"
    # refresh state lightly
    snap="$("$BIN/screen_snap" "$INJECT_SESSION" || true)"
    if [[ -n "$snap" && -f "$snap" ]]; then
      class_json="$(python3 "$BIN/classify_screen.py" "$snap" --session "$INJECT_SESSION" || echo '{}')"
      write_state "$INJECT_SESSION" "$class_json" "manual_inject_cli" "$(last_kick_epoch "$INJECT_SESSION")"
    fi
  fi
  exit 0
fi

SESSIONS=()
if [[ -n "$SESSION_FILTER" ]]; then
  SESSIONS=("$SESSION_FILTER")
else
  SESSIONS=("${DEFAULT_SESSIONS[@]}")
fi

echo "kick starting (dry_run=$DRY_RUN) sessions: ${SESSIONS[*]}"
echo

for s in "${SESSIONS[@]}"; do
  process_session "$s" || true
done

echo "kick done."
