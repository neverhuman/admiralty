#!/usr/bin/env bash
# screen_send SESSION --text 'message' | --keys 'y\r'|enter|esc|y|a|tab|shifttab|altup|ctrlc|...
# Stuff text/keys into a named screen. NEVER uses screen -r/-dr/-D.
set -euo pipefail

SESSION="${1:-}"
shift || true

usage() {
  echo "usage: screen_send SESSION --text 'message'" >&2
  echo "       screen_send SESSION --keys 'y\\r'|enter|esc|y|a|tab|shifttab|altup|ctrlc|always|bypass|2" >&2
  exit 2
}

[[ -z "$SESSION" ]] && usage

MODE=""
PAYLOAD=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --text)
      MODE=text
      PAYLOAD="${2:-}"
      shift 2 || usage
      ;;
    --keys)
      MODE=keys
      PAYLOAD="${2:-}"
      shift 2 || usage
      ;;
    -h|--help) usage ;;
    *)
      echo "unknown arg: $1" >&2
      usage
      ;;
  esac
done

[[ -z "$MODE" ]] && usage

# Verify session exists
if ! screen -ls 2>/dev/null | grep -qE "\\.${SESSION}[[:space:]]"; then
  # also allow exact match on name portion
  if ! screen -S "$SESSION" -Q select . >/dev/null 2>&1; then
    # soft check — still try stuff; screen will error if missing
    :
  fi
fi

stuff_raw() {
  # $1 = literal stuff string for screen -X stuff
  screen -S "$SESSION" -p 0 -X stuff "$1"
}

case "$MODE" in
  text)
    # Escape backslash and single quotes for screen stuff; send CR at end
    # screen -X stuff takes the string literally. Prefer printf %b for escapes.
    # We send the text character-by-character-safe via a single stuff of the message + CR.
    # Avoid interpreting user backslashes as screen escapes accidentally:
    # screen treats ^X as control; we pass plaintext and append \r as two-char screen escape.
    stuff_raw "${PAYLOAD}"
    sleep 0.05
    stuff_raw $'\r'
    ;;
  keys)
    # Named keys and escape sequences
    # screen -X stuff understands ^[ for ESC, \n, \r, ^C etc. in some builds;
    # use literal control chars for portability.
    lower="$(printf '%s' "$PAYLOAD" | tr '[:upper:]' '[:lower:]')"
    case "$lower" in
      enter|cr|return|'\r'|'\\r')
        stuff_raw $'\r'
        ;;
      esc|escape)
        stuff_raw $'\033'
        ;;
      y)
        stuff_raw 'y'
        ;;
      a)
        stuff_raw 'a'
        ;;
      n)
        stuff_raw 'n'
        ;;
      tab)
        stuff_raw $'\t'
        ;;
      shifttab|shift-tab|shift_tab|backtab)
        # CSI Z
        stuff_raw $'\033[Z'
        ;;
      altup|alt-up|alt_up)
        # ESC then Up (common for Codex "alt+↑ to answer")
        stuff_raw $'\033[A'
        ;;
      ctrlc|ctrl-c|ctrl_c)
        stuff_raw $'\003'
        ;;
      ctrlo|ctrl-o|ctrl_o)
        stuff_raw $'\017'
        ;;
      ctrlt|ctrl-t|ctrl_t)
        stuff_raw $'\024'
        ;;
      ctrlu|ctrl-u|ctrl_u)
        stuff_raw $'\025'
        ;;
      always)
        # type the word always + enter (Grok/Claude text approve)
        stuff_raw 'always'
        sleep 0.05
        stuff_raw $'\r'
        ;;
      bypass)
        # Claude shift-tab cycle toward bypass, then often needs confirm
        stuff_raw $'\033[Z'
        ;;
      2)
        # Claude numbered "always allow" option often is 2
        stuff_raw '2'
        ;;
      yes)
        stuff_raw 'yes'
        sleep 0.05
        stuff_raw $'\r'
        ;;
      *)
        # Interpret as printf %b escape string (e.g. y\r, \033[Z)
        # shellcheck disable=SC2059
        interpreted="$(printf '%b' "$PAYLOAD")"
        stuff_raw "$interpreted"
        ;;
    esac
    ;;
esac

echo "sent to $SESSION ($MODE)"
