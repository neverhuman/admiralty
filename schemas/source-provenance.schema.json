{
  "$defs": {
    "OriginReference": {
      "additionalProperties": false,
      "description": "Opaque lookup data only: no fetching, path traversal or authorization.",
      "properties": {
        "record_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "system": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "record_id",
        "revision"
      ],
      "type": "object"
    },
    "RequesterAttribution": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "claimed",
              "type": "string"
            },
            "requester": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "requester"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "description": "Supplied observation time; no wall-clock lookup or freshness claim.",
      "type": "string"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/OriginReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "requester": {
      "$ref": "#/$defs/RequesterAttribution"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "revision",
    "captured_at",
    "requester"
  ],
  "title": "SourceProvenance",
  "type": "object"
}
