    },
    "query_digest": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "query_digest",
    "candidates",
    "coverage"
  ],
  "title": "DuplicatePage",
  "type": "object"
}
