{
  "$defs": {
    "AuthorityRef": {
      "additionalProperties": false,
      "description": "A claimed reference to externally checked policy; JSON cannot install policy.",
      "properties": {
        "generation": {
          "$ref": "#/$defs/CoordinationAuthorityGeneration"
        },
        "policy_digest": {
          "$ref": "#/$defs/CoordinationSha256Digest"
        },
        "reference": {
          "pattern": "^[!-~]{1,512}(?![\\s\\S])",
          "type": "string"
        },
        "scope_digest": {
          "$ref": "#/$defs/CoordinationSha256Digest"
        }
      },
      "required": [
        "reference",
        "generation",
        "policy_digest",
        "scope_digest"
      ],
      "type": "object"
    },
    "ContextEpoch": {
      "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "CoordinationAuthorityGeneration": {
      "allOf": [
        {
          "$ref": "#/$defs/DecimalU64"
        },
        {
          "not": {
            "const": "0"
          }
        }
      ]
    },
    "CoordinationKind": {
      "enum": [
        "task_assigned",
        "task_changed",
        "progress_changed",
        "artifact_ready",
        "interface_proposed",
        "interface_accepted",
        "question_asked",
        "question_answered",
        "decision_requested",
        "decision_recorded",
        "verification_failed",
        "handoff_ready",
        "claim_conflict",
        "budget_warning",
        "cancel_requested",
        "snapshot_required"
      ],
      "type": "string"
    },
    "CoordinationProtocolVersion2": {
      "const": 2,
      "type": "integer"
    },
    "CoordinationSha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "CorrelationId": {
      "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "Cursor": {
      "additionalProperties": false,
      "description": "Versioned projection watermark; this is deliberately not a legacy cursor alias.",
      "properties": {
        "authorization_scope_digest": {
          "$ref": "#/$defs/CoordinationSha256Digest"
        },
        "event_seq": {
          "$ref": "#/$defs/DecimalU64"
        },
        "projection_schema": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "recovery_generation": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "required": [
        "recovery_generation",
        "event_seq",
        "projection_schema",
        "authorization_scope_digest"
      ],
      "type": "object"
    },
    "DecimalU64": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
      "type": "string"
    },
    "PayloadRef": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "#/$defs/CoordinationSha256Digest"
        },
        "size_bytes": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "Priority": {
      "description": "Queue classification only. Even `Control` confers no action capability.",
      "enum": [
        "control",
        "decision",
        "usage",
        "work",
        "progress"
      ],
      "type": "string"
    },
    "RecipientScope": {
      "description": "This component resolves only a concrete principal, never an implicit group.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "principal",
              "type": "string"
            },
            "principal_id": {
              "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "principal_id"
          ],
          "type": "object"
        }
      ]
    },
    "TaskRevisionRef": {
      "additionalProperties": false,
      "properties": {
        "contract_digest": {
          "$ref": "#/$defs/CoordinationSha256Digest"
        },
        "revision": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "task_id": {
          "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "revision",
        "contract_digest"
      ],
      "type": "object"
    },
    "TopicId": {
      "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,256}(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "#/$defs/AuthorityRef"
    },
    "baseline_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoordinationSha256Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "causation_id": {
      "anyOf": [
        {
          "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_epoch": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextEpoch"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "$ref": "#/$defs/CorrelationId"
    },
    "expires_at_unix_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecimalU64"
        },
        {
          "type": "null"
        }
      ],
      "description": "Unix milliseconds, supplied as a canonical decimal string, never a float."
    },
    "kind": {
      "$ref": "#/$defs/CoordinationKind"
    },
    "message_id": {
      "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "payload_ref": {
      "$ref": "#/$defs/PayloadRef"
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "project_id": {
      "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "protected_facts_digest": {
      "$ref": "#/$defs/CoordinationSha256Digest"
    },
    "protocol_version": {
      "$ref": "#/$defs/CoordinationProtocolVersion2"
    },
    "recipient": {
      "$ref": "#/$defs/RecipientScope"
    },
    "root_id": {
      "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "sender": {
      "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "source_cursor": {
      "$ref": "#/$defs/Cursor"
    },
    "task_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskRevisionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "topic": {
      "$ref": "#/$defs/TopicId"
    }
  },
  "required": [
    "protocol_version",
    "message_id",
    "project_id",
    "root_id",
    "sender",
    "recipient",
    "topic",
    "task_revision",
    "causation_id",
    "correlation_id",
    "source_cursor",
    "authority",
    "context_epoch",
    "baseline_digest",
    "protected_facts_digest",
    "payload_ref",
    "kind",
    "priority",
    "expires_at_unix_ms"
  ],
  "title": "CoordinationEnvelopeV2",
  "type": "object"
}
