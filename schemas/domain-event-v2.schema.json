{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "check_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "check_ids"
      ],
      "type": "object"
    },
    "AttemptId": {
      "type": "string"
    },
    "CandidateDecisionEvidence": {
      "additionalProperties": false,
      "description": "Bind trusted verifier execution and custody to the exact candidate. Digests\nand names alone are claims; Store's configured authority must authenticate\nthese against the runtime's non-deserializable execution evidence.",
      "properties": {
        "closure_digest": {
          "description": "Independent supervisor closure/fencing evidence, not the check receipt.",
          "type": "string"
        },
        "contract_digest": {
          "type": "string"
        },
        "custody_digest": {
          "type": "string"
        },
        "receipt_digest": {
          "type": "string"
        },
        "source_commit_sha": {
          "type": "string"
        },
        "source_tree_sha": {
          "type": "string"
        },
        "verification_policy_digest": {
          "type": "string"
        },
        "verifier": {
          "$ref": "#/$defs/PrincipalId"
        }
      },
      "required": [
        "contract_digest",
        "verification_policy_digest",
        "receipt_digest",
        "custody_digest",
        "closure_digest",
        "source_commit_sha",
        "source_tree_sha",
        "verifier"
      ],
      "type": "object"
    },
    "CheckSpec": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "timeout_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "program",
        "args",
        "cwd",
        "timeout_secs"
      ],
      "type": "object"
    },
    "CoordinationMessage": {
      "additionalProperties": false,
      "properties": {
        "authority_ref": {
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/MessageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_epoch": {
          "type": "string"
        },
        "message_id": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/MessagePayload"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "recipient": {
          "$ref": "#/$defs/PrincipalId"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sender": {
          "$ref": "#/$defs/PrincipalId"
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "project_id",
        "sender",
        "recipient",
        "context_epoch",
        "authority_ref",
        "payload"
      ],
      "type": "object"
    },
    "DomainEvent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contract": {
              "$ref": "#/$defs/TaskContract"
            },
            "kind": {
              "const": "task_submitted",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "contract"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt_id": {
              "$ref": "#/$defs/AttemptId"
            },
            "kind": {
              "const": "task_claimed",
              "type": "string"
            },
            "owner": {
              "$ref": "#/$defs/PrincipalId"
            },
            "revision": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            }
          },
          "required": [
            "kind",
            "task_id",
            "revision",
            "attempt_id",
            "owner"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt_id": {
              "$ref": "#/$defs/AttemptId"
            },
            "kind": {
              "const": "task_started",
              "type": "string"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            }
          },
          "required": [
            "kind",
            "task_id",
            "attempt_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt_id": {
              "$ref": "#/$defs/AttemptId"
            },
            "candidate_ref": {
              "type": "string"
            },
            "kind": {
              "const": "candidate_submitted",
              "type": "string"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            }
          },
          "required": [
            "kind",
            "task_id",
            "attempt_id",
            "candidate_ref"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "message_queued",
              "type": "string"
            },
            "message": {
              "$ref": "#/$defs/CoordinationMessage"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "context_epoch": {
              "type": "string"
            },
            "kind": {
              "const": "message_acknowledged",
              "type": "string"
            },
            "message_id": {
              "$ref": "#/$defs/MessageId"
            },
            "recipient": {
              "$ref": "#/$defs/PrincipalId"
            }
          },
          "required": [
            "kind",
            "message_id",
            "recipient",
            "context_epoch"
          ],
          "type": "object"
        }
      ]
    },
    "LifecycleAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "action": {
              "const": "decide_candidate",
              "type": "string"
            },
            "attempt_id": {
              "$ref": "#/$defs/AttemptId"
            },
            "candidate_ref": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/CandidateDecisionEvidence"
            }
          },
          "required": [
            "action",
            "attempt_id",
            "candidate_ref",
            "evidence",
            "accepted"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The supervisor must prove closure before recording this fact. Unknown\nchild/effect outcomes retain ownership and cannot authorize a retry.",
          "properties": {
            "action": {
              "const": "close_attempt",
              "type": "string"
            },
            "attempt_id": {
              "$ref": "#/$defs/AttemptId"
            },
            "cancelled": {
              "type": "boolean"
            },
            "closure_digest": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "attempt_id",
            "closure_digest",
            "reason",
            "cancelled"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "retry",
              "type": "string"
            },
            "attempt_id": {
              "$ref": "#/$defs/AttemptId"
            },
            "closure_digest": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "attempt_id",
            "closure_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "cancel_pending",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "revise_contract",
              "type": "string"
            },
            "contract": {
              "$ref": "#/$defs/TaskContract"
            }
          },
          "required": [
            "action",
            "contract"
          ],
          "type": "object"
        }
      ]
    },
    "LifecycleCommand": {
      "additionalProperties": false,
      "description": "A CAS binds all task state, including contract, candidate and attempt history.\nThis is untrusted input, never proof of the actor's authority or check execution.",
      "properties": {
        "action": {
          "$ref": "#/$defs/LifecycleAction"
        },
        "actor": {
          "$ref": "#/$defs/PrincipalId"
        },
        "expected_task_digest": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "maximum": 2,
          "minimum": 2,
          "type": "integer"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "protocol_version",
        "task_id",
        "expected_task_digest",
        "actor",
        "action"
      ],
      "type": "object"
    },
    "LifecycleRecord": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "$ref": "#/$defs/LifecycleCommand"
            },
            "kind": {
              "const": "task_lifecycle",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "MessageId": {
      "type": "string"
    },
    "MessagePayload": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contract_digest": {
              "type": "string"
            },
            "kind": {
              "const": "task_assigned",
              "type": "string"
            },
            "revision": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            }
          },
          "required": [
            "kind",
            "task_id",
            "revision",
            "contract_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "question",
              "type": "string"
            },
            "options": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "question": {
              "type": "string"
            },
            "requirement": {
              "type": "string"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            }
          },
          "required": [
            "kind",
            "task_id",
            "requirement",
            "question",
            "options"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "answer": {
              "type": "string"
            },
            "decision_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "answer",
              "type": "string"
            },
            "question_id": {
              "$ref": "#/$defs/MessageId"
            }
          },
          "required": [
            "kind",
            "question_id",
            "answer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_ref": {
              "type": "string"
            },
            "interface_revision": {
              "type": "string"
            },
            "kind": {
              "const": "artifact_ready",
              "type": "string"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            }
          },
          "required": [
            "kind",
            "task_id",
            "artifact_ref",
            "interface_revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "candidate_ref": {
              "type": "string"
            },
            "failed_check": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "handoff",
              "type": "string"
            },
            "next_action": {
              "type": "string"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            }
          },
          "required": [
            "kind",
            "task_id",
            "candidate_ref",
            "next_action"
          ],
          "type": "object"
        }
      ]
    },
    "PrincipalId": {
      "type": "string"
    },
    "ProjectId": {
      "type": "string"
    },
    "RootId": {
      "type": "string"
    },
    "TaskContract": {
      "additionalProperties": false,
      "properties": {
        "authority_ref": {
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckSpec"
          },
          "type": "array"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/TaskId"
          },
          "type": "array"
        },
        "forbidden_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_attempts": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "non_goals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objective": {
          "type": "string"
        },
        "owned_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "read_first": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revision": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "root_id": {
          "$ref": "#/$defs/RootId"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "simulated": {
          "type": "boolean"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "root_id",
        "task_id",
        "revision",
        "title",
        "objective",
        "non_goals",
        "owned_paths",
        "forbidden_paths",
        "read_first",
        "dependencies",
        "criteria",
        "checks",
        "authority_ref",
        "max_attempts",
        "simulated"
      ],
      "type": "object"
    },
    "TaskId": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/DomainEvent"
    },
    {
      "$ref": "#/$defs/LifecycleRecord"
    }
  ],
  "description": "Schema-only v2 union. The journal's `DomainEvent` is the Rust wire decoder;\nthis type deliberately has no serde codec or competing untagged decoder.\nIt retains old journal bytes without extending the frozen v1 schema.",
  "title": "DomainEventV2"
}
