{
  "$defs": {
    "ConsumerCompatibilityPolicy": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "exact_producer_revision",
              "type": "string"
            },
            "required_producer_revision": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "policy",
            "required_producer_revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max_producer_revision": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "min_producer_revision": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "policy": {
              "const": "backward_compatible_range",
              "type": "string"
            },
            "required_final_producer_revision": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "policy",
            "min_producer_revision",
            "max_producer_revision",
            "required_final_producer_revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "min_provisional_producer_revision": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "policy": {
              "const": "provisional_development_allowed",
              "type": "string"
            },
            "required_final_producer_revision": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "policy",
            "min_provisional_producer_revision",
            "required_final_producer_revision"
          ],
          "type": "object"
        }
      ]
    },
    "CoordinationSha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "DecimalU64": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
      "type": "string"
    },
    "InterfaceBindingStatus": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "provisional",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "verified",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "const": "revoked",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "superseded",
              "type": "string"
            },
            "superseded_by_interface_revision": {
              "$ref": "#/$defs/DecimalU64"
            }
          },
          "required": [
            "state",
            "superseded_by_interface_revision"
          ],
          "type": "object"
        }
      ]
    },
    "InterfaceId": {
      "type": "string"
    },
    "ProjectId": {
      "type": "string"
    },
    "RootId": {
      "type": "string"
    },
    "TaskRevisionRef": {
      "additionalProperties": false,
      "properties": {
        "contract_digest": {
          "$ref": "#/$defs/CoordinationSha256Digest"
        },
        "revision": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "task_id": {
          "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "revision",
        "contract_digest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_check_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "artifact_digest": {
      "$ref": "#/$defs/CoordinationSha256Digest"
    },
    "authority_ref": {
      "type": "string"
    },
    "compatibility_policy": {
      "$ref": "#/$defs/ConsumerCompatibilityPolicy"
    },
    "consumer_tasks": {
      "items": {
        "$ref": "#/$defs/TaskRevisionRef"
      },
      "type": "array"
    },
    "interface_id": {
      "$ref": "#/$defs/InterfaceId"
    },
    "interface_revision": {
      "$ref": "#/$defs/DecimalU64"
    },
    "producer_task": {
      "$ref": "#/$defs/TaskRevisionRef"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "root_id": {
      "$ref": "#/$defs/RootId"
    },
    "schema_digest": {
      "$ref": "#/$defs/CoordinationSha256Digest"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/InterfaceBindingStatus"
    }
  },
  "required": [
    "schema_version",
    "interface_id",
    "project_id",
    "root_id",
    "authority_ref",
    "interface_revision",
    "producer_task",
    "consumer_tasks",
    "artifact_digest",
    "schema_digest",
    "compatibility_policy",
    "acceptance_check_ids",
    "status"
  ],
  "title": "TaskInterfaceContractV2",
  "type": "object"
}
