{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "check_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "check_ids"
      ],
      "type": "object"
    },
    "CheckSpec": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "timeout_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "program",
        "args",
        "cwd",
        "timeout_secs"
      ],
      "type": "object"
    },
    "DeliveryRequirement": {
      "additionalProperties": false,
      "description": "Outside TaskContractv1. A generation is a new immutable requirement, never\na rewrite of prior evidence. Unknown is never optional/not-applicable.",
      "properties": {
        "contract_digest": {
          "type": "string"
        },
        "contract_revision": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/DeliveryTarget"
          },
          "type": "array"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "contract_revision",
        "contract_digest",
        "generation",
        "targets"
      ],
      "type": "object"
    },
    "DeliveryStage": {
      "enum": [
        "candidate",
        "verified",
        "merged",
        "packaged",
        "staged",
        "installed",
        "running",
        "released"
      ],
      "type": "string"
    },
    "DeliveryTarget": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "requirement": {
          "$ref": "#/$defs/TargetRequirement"
        },
        "target_kind": {
          "$ref": "#/$defs/DeliveryTargetKind"
        }
      },
      "required": [
        "id",
        "target_kind",
        "requirement"
      ],
      "type": "object"
    },
    "DeliveryTargetKind": {
      "enum": [
        "repository",
        "deployment"
      ],
      "type": "string"
    },
    "IntakeItem": {
      "additionalProperties": false,
      "properties": {
        "claimed_project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outcomes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OutcomeInput"
          },
          "type": "array"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_timing": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "OutcomeInput": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "delivery": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryRequirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "source_spans": {
          "default": [],
          "description": "Raw source byte offsets, NOT decoded `text` offsets. Empty is unresolved.",
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "type": "array"
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskContract"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    },
    "ProjectId": {
      "type": "string"
    },
    "RootId": {
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "TargetRequirement": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "required",
              "type": "string"
            },
            "stage": {
              "$ref": "#/$defs/DeliveryStage"
            }
          },
          "required": [
            "kind",
            "stage"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "optional",
              "type": "string"
            },
            "stage": {
              "$ref": "#/$defs/DeliveryStage"
            }
          },
          "required": [
            "kind",
            "stage"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "not_applicable",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "TaskContract": {
      "additionalProperties": false,
      "properties": {
        "authority_ref": {
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckSpec"
          },
          "type": "array"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/TaskId"
          },
          "type": "array"
        },
        "forbidden_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_attempts": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "non_goals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objective": {
          "type": "string"
        },
        "owned_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "read_first": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revision": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "root_id": {
          "$ref": "#/$defs/RootId"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "simulated": {
          "type": "boolean"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "root_id",
        "task_id",
        "revision",
        "title",
        "objective",
        "non_goals",
        "owned_paths",
        "forbidden_paths",
        "read_first",
        "dependencies",
        "criteria",
        "checks",
        "authority_ref",
        "max_attempts",
        "simulated"
      ],
      "type": "object"
    },
    "TaskId": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/IntakeItem"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "title": "IntakeBatch",
  "type": "object"
}
