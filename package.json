  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "check": "cargo xtask check",
    "contracts:generate": "node scripts/contracts/generate.ts",
    "contracts:check": "node scripts/contracts/generate.ts --check",
    "demo": "cargo xtask demo",
    "live": "cargo xtask live",
    "demo:capture": "node scripts/demos/capture.ts",
    "demo:encode": "node scripts/demos/encode.ts",
    "demo:verify": "node scripts/demos/verify.ts",
    "scripts:typecheck": "pnpm --dir apps/dashboard exec tsc -p ../../scripts/tsconfig.json --pretty false",
    "scripts:check": "pnpm scripts:typecheck && node --test scripts/demos/media.test.ts"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "json-schema-to-typescript": "16.0.0"
  }
}
