  "implementation": {
    "controller": "admit_one_slotted binds held registry model ID to exact outbox declaration and joins actual Store claim/budget/hold/intent; no lower-protection fallback",
    "factory": "Private retained exact ModelSpec/task plus original PreparedCodexLaunch tuple/spec; independent fullModelSpec and routingtuple digest domains, registry/provider/observed identities remain separate",
    "inference_and_kernel": "Inference claim digest never replaces full kernel claims or kernel reservation scope. Current Store profile binds command source incarnation to kernel scope while Codex tuple producer incarnation remains distinct.",
    "ownership": "Factory binding failure returns original bound preparation, both proofs/commands and claim. RejectedSlotAdmission boxes and returns original plan+private slot; no clone or capability loss.",
    "private_binding": "NonClone/nonDeserialize/no public constructor; matches exact request/spec/full resource claims/whole reservation/authority Arc/workspace metadata/head/tree. Does not attest live inode custody/current policy.",
    "retention": "Native loop holds original private mapping/commands/proofs, hold/pool physical key/generation and original CAS-successor receipts across uncertain replies.",
    "current_checks": "Exact original slotted controller replay and current authorized whole budget/hold/key/generation on admission retry and dispatch, repeated at RecordingRuntime after final clock sample; unrelated global ledger updates allowed.",
    "unknowns": "Dispatch-held/unknown cannot requeue, downgrade, refund or release; occupancy and budget liability remain.",
    "policy_fence": "Separate observational policies sampled sequentially, no common retained authorization fence or physical-start linearization installed."
  },
